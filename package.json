{
  "name": "soundscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:site": "node tools/fetch-model.mjs && vite build --mode site",
    "serve:site": "node tools/serve-site.mjs",
    "deploy": "npm run build:site && wrangler pages deploy dist-site --project-name soundscope --branch main",
    "deploy:preview": "npm run build:site && wrangler pages deploy dist-site --project-name soundscope --branch preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@mediabunny/ac3": "1.61.3",
    "lucide-react": "0.460.0",
    "mediabunny": "^1.61.3",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wavesurfer.js": "^8.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.56.1",
    "puppeteer-core": "^25.12.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
